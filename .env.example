# Copy to .env and fill in. Never commit .env.

# ---- Storage ----
DATA_DIR=data
SQLITE_PATH=data/app.db
CHROMA_DIR=data/chroma

# ---- Models (CPU only) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# ---- Chunking (characters; ~1200 chars is ~300 tokens, well under bge-small's 512) ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- IPO watcher ----
WATCHER_INTERVAL_MINUTES=360
WATCHER_LOOKBACK_DAYS=45
HTTP_TIMEOUT_SECONDS=60
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---- LLM providers (Phase 3, free tiers only) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Ordered fallback list tried when a provider is rate-limited or down
LLM_PROVIDER_ORDER=gemini,groq,openrouter,cerebras
# Debaters and Judge must run on different providers
DEBATER_PROVIDER=gemini
JUDGE_PROVIDER=groq
